function addDivToAccountFrame() {
    // Check if the element with ID 'accountFrame' exists
    var accountFrame = document.getElementById('accountFrame');
    if (accountFrame) {
       

  // If 'accountFrame' does not exist, remove any existing divs with class 'js' from the body
        var existingDiv = document.body.querySelector('.js');
var existingDivs = document.body.querySelector('.bg-col');
        if (existingDiv) {
            document.body.removeChild(existingDiv);
        }
if (existingDivs) {
            document.body.removeChild(existingDivs);
        }
        // Create a new div element
        var newDiv = document.createElement('div');
 var newDivs = document.createElement('div');
        // Add class 'js' to the new div
        newDiv.className = 'js';
 newDivs.className = 'bg-col';
        // Append the new div to the body

        document.body.appendChild(newDiv);
document.body.appendChild(newDivs);
    } else {
       // If 'accountFrame' exists, remove any existing divs with class 'js' inside it
        //var existingDiv = accountFrame.querySelector('.js');
        if (existingDiv) {
           // accountFrame.removeChild(existingDiv);
        }
        // Create a new div element
        //var newDiv = document.createElement('div');
        // Add class 'js' to the new div
        //newDiv.className = 'js';
        // Append the new div inside the 'accountFrame' element
        //accountFrame.appendChild(newDiv);
    }
}

// Call the function every second to check if 'accountFrame' exists
setInterval(function() {
    addDivToAccountFrame();
}, 1000); // Execute every 1000 milliseconds (1 second)
</script>
