# Secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local-only data (the DB is the source of truth; never commit dumps)
*.dump
*.sql.gz
backup-local/

# Node / tooling
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vitest/

# Local agent scratch
.superpowers/

# OS / editors
.DS_Store
.idea/
.vscode/

# Python bytecode (bots commit witness scripts under docs/requests)
__pycache__/
*.pyc
