<?xml version="1.0" encoding="UTF-8"?>
<!-- CR-041: the production API on the Mac mini. install.sh fills the __PLACEHOLDERS__. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.domaintrading.api</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOST_DIR__/start.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__PATH__</string><key>HOME</key><string>__HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/api.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/api.log</string>
</dict>
</plist>
