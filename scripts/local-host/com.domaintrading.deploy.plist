<?xml version="1.0" encoding="UTF-8"?>
<!-- CR-041: every 10 minutes, deploy a new release tag whose CI passed. install.sh fills the __PLACEHOLDERS__. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.domaintrading.deploy</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__PROD_DIR__/scripts/local-host/deploy.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__PATH__</string><key>HOME</key><string>__HOME__</string></dict>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/deploy.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/deploy.log</string>
</dict>
</plist>
