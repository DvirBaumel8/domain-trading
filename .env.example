# domain-trading API: SERVER environment variables.
# In production these are Render env vars: render.yaml sets the plain ones (APP_ENV=production,
# DATABASE_SSL=true, ENABLED_REGISTRARS=porkbun,godaddy) and prompts for the secrets (sync: false):
# DATABASE_URL, PORKBUN_API_KEY, PORKBUN_SECRET_API_KEY, GODADDY_PAT, GITHUB_BACKUP_TOKEN, GITHUB_BACKUP_REPO, JOB_TRIGGER_TOKEN, GOOGLE_WEB_RISK_API_KEY, COMPANIES_HOUSE_API_KEY.
# Step by step: docs/DEPLOYMENT.md.
# For local dev: copy to .env (gitignored), chmod 600. NEVER put production (Neon) values in .env: use .env.neon (gitignored, chmod 600). Never commit real values. No endpoint ever returns them.
# Bots (Gavriel, Gizbar) never see these. Gavriel holds only the API's READ/WRITE bearer tokens.
# Screening sources (NameBio, Internet Archive, popularity list, RDAP, SURBL) are NOT env vars: they are switched in the selection settings (`sources.*`, via the settings API). v1.1.0 adds no env var.
# Leave a registrar's keys blank to disable that adapter. `npm run admin -- doctor` lists enabled adapters (never prints keys).

# ---- Core ----
DATABASE_URL=postgres://dt:dt@localhost:5433/domain_trading   # docker compose (port 5433)
TEST_DATABASE_URL=postgres://dt:dt@localhost:5433/domain_trading_test
PORT=3000
LOG_LEVEL=info
DATABASE_SSL=false                  # true for Neon (TLS, certificate verified). Default off (local docker has no TLS).
# With DATABASE_SSL=true put ?sslmode=verify-full on the URL. APP_ENV=production REQUIRES DATABASE_SSL=true and sslmode=verify-full (require/none refuse to start).
# Outside production, verify-full, require or no sslmode are accepted; disable/no-verify/prefer/allow are refused.
# Production (Neon): use the DIRECT connection string. A host containing "-pooler." is refused when APP_ENV=production,
# because the per-domain lock is a session advisory lock and breaks behind a transaction-mode pooler.
APP_ENV=development                 # development | test | production
ENABLED_REGISTRARS=porkbun          # comma list; an adapter also needs its keys + passing contract tests
# Caps and listing settings are NOT env vars: the server reads the DB tables `settings` (max_domains 40, approval_max_age_hours 72, lander_target afternic, allowed_registrars, high_value_min_bin_cents,
# sedo_hybrid_as make_offer) and `pricing_settings` (versioned). They change only via an admin command or a migration, never the API.
# Optional server settings (defaults shown):
# HOST=0.0.0.0
# DNS_NS_SERVER=192.5.6.30           # public-DNS NS check server (a.gtld-servers.net)
# SEDO_TEMPLATE_PATH=templates/sedo_template.json   # until this file exists, GET /export/sedo.csv answers 501 SEDO_TEMPLATE_MISSING
# API bearer tokens are NOT env vars: create them with `npm run admin -- token create --scope read|write --name ...`
# (stored as SHA-256 in api_tokens; the plain token is printed once).

# ---- Scheduled jobs (free hosting: an external trigger calls POST /jobs/run) ----
JOB_TRIGGER_TOKEN=                  # bearer for POST /jobs/run ONLY (not a READ/WRITE API token). At least 32 non-space chars. Generate: openssl rand -hex 32. Unset → the route returns 503 JOBS_DISABLED

# ---- Optional Google Web Risk (Lookup API only; free tier; the service stops at 10,000 lookups per UTC month) ----
# Sent as the x-goog-api-key header, never in a URL. Empty/unset -> the web_risk check stays MANUAL_REQUIRED (record it by hand).
GOOGLE_WEB_RISK_API_KEY=            # e.g. a Cloud API key restricted to the Web Risk API (never commit a real one)

# ---- Optional Companies House (v4.2.0, CR-046 item 2): the free API key; company-name matches are a screening input only ----
# Sent as HTTP Basic auth (key as the user name, empty password), never logged or returned. Empty = the companies check answers UNKNOWN SOURCE_DISABLED.
COMPANIES_HOUSE_API_KEY=            # never commit a real one

# ---- Optional NameBio free files (v5.11.0, CR-062): only used when sources.namebio is on (off by default; Dvir's OK to turn it on) ----
# Free public download on api.namebio.com (GET, no login), fetched at most once a day. Attribution "Data from NameBio" is required wherever the numbers are shown.
# Empty RetailStats URL = the daily step asks the free per-keyword RetailStats endpoint for the candidate pool instead (4 a minute). Only keywords of intake names, owned domains and recently screened names are stored (file read cap 100 MB).
NAMEBIO_RETAILSTATS_CSV_URL=https://api.namebio.com/retailstats-download

# ---- Optional Spaceship SellerHub listing sync (v4.0.0, CR-049): a key pair with ONLY the sellerhub:read and sellerhub:write scopes (not the registrar pair) ----
# Both empty = the daily listingSync step is skipped. Sent as headers X-API-Key / X-API-Secret, never logged or returned. SPACESHIP_SELLERHUB_BASE_URL defaults to https://spaceship.dev/api.
SPACESHIP_SELLERHUB_API_KEY=
SPACESHIP_SELLERHUB_API_SECRET=

# ---- The service's own public URL (the job queue's keep-alive ping) ----
PUBLIC_BASE_URL=https://domain-trading-api.onrender.com

# ---- Optional nightly backup to GitHub (last step of the daily job; docs/internal/backup.md) ----
# A SEPARATE PRIVATE repo for data only (never the code repo; the server refuses it). Recommended: DvirBaumel8/domain-trading-data.
# Fine-grained PAT: repository access = that data repo ONLY, permission Contents: Read and write, 1-year expiry.
# Every run checks the repo is private and refuses otherwise. The branch is fixed: data-backup (not configurable).
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=DvirBaumel8/domain-trading-data

# ---- Porkbun (adapter #1, fully specified) ----
# Create: https://porkbun.com/account/api  -> "Create API Key" (gives pk1_... and sk1_...)
# Also on that page:
#   - turn ON "Opt In All Domains" (otherwise each new domain must be opted in to API access before the service can set NS/auto-renew)
#   - set a Monthly API spend limit (default is $100/month if you set nothing; purchases above it are refused by Porkbun)
#   - optional: restrict the key by IP. SKIP it on Render free (shared, changing outbound IPs: you would get IP_NOT_ALLOWED);
#     the spend limit and prepaid credit are the real limits.
# Account must have verified email + phone (VERIFICATION_REQUIRED otherwise).
# Purchases are paid from PREPAID ACCOUNT CREDIT only: add credit at https://porkbun.com/account/credit
# Recommended: keep auto top-up OFF so the credit balance is your hard spending limit.
# Sandbox keys (pk1_sb_...) run the full API with fake credit: use them for tests.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
PORKBUN_BASE_URL=   # optional; default https://api.porkbun.com/api/json/v3 (sandbox uses the same URL with pk1_sb_ keys)
PORKBUN_SANDBOX_API_KEY=
PORKBUN_SANDBOX_SECRET_API_KEY=

# ---- Registrars with no adapter yet (only Porkbun and GoDaddy have code) ----
# These names are listed in src/modules/registrars/registry.ts but setting them enables nothing until an adapter ships
# (CR-003 Dynadot; the others are research only, docs/research/). Left commented on purpose; do not fill them.
# DYNADOT_API_KEY=
# DYNADOT_API_SECRET=
# NAMECOM_USERNAME=
# NAMECOM_API_TOKEN=
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_USERNAME=
# NAMECHEAP_CLIENT_IP=
# SPACESHIP_API_KEY=
# SPACESHIP_API_SECRET=
# NAMESILO_API_KEY=

# ---- GoDaddy (management-only in v1: D-001 promptinjectionaudit.com is registered here) ----
# Access (GoDaddy Help 42424, checked 3 Oct 2026): >=1 active domain -> Domains API (management/DNS/nameservers), 20k calls/month.
# Availability checks need >=50 domains or >=$20/month average spend -> GoDaddy is NOT a /check or /buy source for this account.
# Ineligible -> 403 with code ACCOUNT_NOT_ELIGIBLE -> use `npm run admin -- import-domain --manual` and change NS by hand.
# PAT scopes for v1: domains.domain:read, domains.nameserver:update (no purchase scopes).
# Check in the dashboard: auto-renew OFF for D-001 (renewals bill the card on file; the server cap can't block them).
# Domains v3 API uses a Personal Access Token (PAT): https://developer.godaddy.com/docs/api-users/auth/how-to
# Registration requires a billing method on file or a funded Good as Gold balance.
# Note: GoDaddy charges the DISCOUNTED renewal only with auto-renew ON; manual renewals are at the standard rate.
GODADDY_PAT=
GODADDY_BASE_URL=   # optional; default https://api.godaddy.com (must be https outside tests)

# ---- Cloudflare Registrar: NOT SUPPORTED (no third-party nameservers -> cannot point to a for-sale lander) ----

# ---- Daily data save (CR-071, the `datasave` job) ----
# Where raw GoDaddy inventory zips are kept for 7 days. Default: ~/Library/Application Support/domain-trading/snapshots (the Mac host).
# If the folder cannot be written (Render has no disk) the job still runs; the manifests say raw_available=false.
SNAPSHOT_DIR=
# CR-081: root of the daily GoDaddy archive (compact .com rows <= the S8 cap, gzip, kept for the replay); empty = a sibling folder `archive` of SNAPSHOT_DIR
ARCHIVE_DIR=
# Dynadot (read-only closeouts and aftermarket) is NOT built: no key exists. The two Dynadot steps report not_configured.
# DYNADOT_API_KEY=
