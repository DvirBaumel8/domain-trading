# Server environment (Render dashboard in production; .env locally, gitignored). Never commit real values.
PORT=3000
LOG_LEVEL=info
# Bearer tokens that may read the API, as name:sha256 pairs, comma separated. Make a token and its hash:
#   t="dt_$(openssl rand -hex 32)"; printf %s "$t" | shasum -a 256
API_TOKENS=
# Porkbun keys for GET /check (both or neither). The app only asks for prices.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
