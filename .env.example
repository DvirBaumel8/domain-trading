# Server environment (Render dashboard in production; .env locally, gitignored). Never commit real values.
PORT=3000
LOG_LEVEL=info
# Porkbun keys for GET /check (both or neither). The app only asks for prices.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
# Read-only sources (docs/contract/endpoints.md). Without a key its route says so.
GOOGLE_WEB_RISK_API_KEY=
GODADDY_DOMAINS_PAT=
GODADDY_API_KEY=
GODADDY_API_SECRET=
AFTERNIC_API_KEY=
AFTERNIC_API_SECRET=
USPTO_API_KEY=
