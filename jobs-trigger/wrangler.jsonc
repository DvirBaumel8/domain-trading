{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domain-trading-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "triggers": {
    "crons": ["0 * * * *", "30 0 * * *"]
  },
  "vars": {
    // Placeholder; the deploy workflow overrides it with --var API_BASE_URL:<repo variable>.
    "API_BASE_URL": "https://example.invalid"
  }
}
