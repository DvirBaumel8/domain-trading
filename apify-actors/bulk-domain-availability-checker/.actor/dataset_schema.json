{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "domain": {
        "type": [
          "string",
          "null"
        ],
        "description": "Domain checked (lower case, IDN names in xn-- form)"
      },
      "available": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true = not registered, false = registered, null = not known (unknown, likely_available or invalid_tld)"
      },
      "status": {
        "type": [
          "string",
          "null"
        ],
        "description": "available | likely_available | registered | unknown | invalid_tld. likely_available: real TLD without a public RDAP server and DNS says the name does not exist, so the registry could not confirm it. invalid_tld: the TLD is not in the IANA root zone list (not charged)"
      },
      "method": {
        "type": [
          "string",
          "null"
        ],
        "description": "rdap = the registry's RDAP server answered, dns = decided from DNS only"
      },
      "hasDns": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Domain has nameservers in DNS"
      },
      "nameservers": {
        "type": [
          "array",
          "null"
        ],
        "description": "Nameservers if any"
      },
      "registrar": {
        "type": [
          "string",
          "null"
        ],
        "description": "Registrar name (RDAP)"
      },
      "createdDate": {
        "type": [
          "string",
          "null"
        ],
        "description": "Registration date (RDAP)"
      },
      "expiryDate": {
        "type": [
          "string",
          "null"
        ],
        "description": "Expiry date (RDAP)"
      },
      "domainAgeYears": {
        "type": [
          "number",
          "null"
        ],
        "description": "Age in years (RDAP)"
      },
      "rdapStatus": {
        "type": [
          "array",
          "null"
        ],
        "description": "EPP status codes (RDAP)"
      },
      "keyword": {
        "type": [
          "string",
          "null"
        ],
        "description": "The keyword the name was generated from; null for names you pasted in Domains"
      },
      "tld": {
        "type": [
          "string",
          "null"
        ],
        "description": "TLD"
      },
      "length": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Length of the name without TLD"
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Reason or note when status is unknown, likely_available or invalid_tld; null otherwise"
      },
      "checkedAt": {
        "type": [
          "string",
          "null"
        ],
        "description": "UTC timestamp"
      },
      "parkedOrForSale": {
        "type": [
          "string",
          "null"
        ],
        "description": "Parking or marketplace service detected from the nameservers (for example Afternic, Sedo, Dan.com); null if none"
      }
    },
    "required": [
      "domain",
      "available",
      "status",
      "method",
      "tld",
      "length",
      "checkedAt"
    ]
  },
  "views": {
    "overview": {
      "title": "Availability",
      "transformation": {
        "fields": [
          "domain",
          "status",
          "available",
          "method",
          "registrar",
          "parkedOrForSale",
          "createdDate",
          "expiryDate",
          "domainAgeYears",
          "error"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "domain": {
            "label": "Domain"
          },
          "status": {
            "label": "Status"
          },
          "available": {
            "label": "Available"
          },
