{
  "title": "Bulk PageSpeed Checker",
  "type": "object",
  "schemaVersion": 1,
  "required": [
    "urls",
    "apiKey"
  ],
  "properties": {
    "urls": {
      "title": "URLs",
      "type": "array",
      "description": "Pages to test. https:// is added when missing.",
      "editor": "stringList",
      "prefill": [
        "https://example.com/"
      ]
    },
    "strategies": {
      "title": "Strategies",
      "type": "array",
      "description": "Mobile, desktop or both.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "mobile",
          "desktop"
        ]
      },
      "default": [
        "mobile",
        "desktop"
      ]
    },
    "categories": {
      "title": "Categories",
      "type": "array",
      "description": "Lighthouse categories to score. Performance is always useful; the others are optional.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      },
      "default": [
        "performance"
      ]
    },
    "apiKey": {
      "title": "Google PageSpeed Insights API key",
      "type": "string",
      "description": "Your own Google API key with the PageSpeed Insights API enabled. Required. It is never logged or written to the results.",
      "editor": "textfield",
      "isSecret": true
    }
  }
}
