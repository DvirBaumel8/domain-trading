{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "domain": {
        "type": [
          "string",
          "null"
        ],
        "description": "Domain checked, in lower case (URLs and emails are reduced to their domain)"
      },
      "resolves": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true = the domain exists in DNS, false = NXDOMAIN (does not exist), null = DNS lookup failed"
      },
      "a": {
        "type": [
          "array",
          "null"
        ],
        "description": "IPv4 addresses"
      },
      "aaaa": {
        "type": [
          "array",
          "null"
        ],
        "description": "IPv6 addresses"
      },
      "ns": {
        "type": [
          "array",
          "null"
        ],
        "description": "Nameservers"
      },
      "mx": {
        "type": [
          "array",
          "null"
        ],
        "description": "MX records as {priority, host}, lowest priority first. An empty list means no MX record, or a null MX (see issues)"
      },
      "emailProvider": {
        "type": [
          "string",
          "null"
        ],
        "description": "Detected email provider (Google Workspace, Microsoft 365, ...)"
      },
      "spf": {
        "type": [
          "string",
          "null"
        ],
        "description": "SPF record"
      },
      "spfAll": {
        "type": [
          "string",
          "null"
        ],
        "description": "How the SPF record ends: -all, ~all, ?all or +all. null = no SPF record, or no 'all' mechanism"
      },
      "spfLookups": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Approximate DNS-lookup mechanisms in SPF (limit is 10)"
      },
      "dmarc": {
        "type": [
          "string",
          "null"
        ],
        "description": "DMARC record text from _dmarc.<domain>. null = no DMARC record"
      },
      "dmarcPolicy": {
        "type": [
          "string",
          "null"
        ],
        "description": "DMARC p= policy (none/quarantine/reject)"
      },
      "dmarcRua": {
        "type": [
          "string",
          "null"
        ],
        "description": "DMARC aggregate report address"
      },
      "dkimSelectorsFound": {
        "type": [
          "array",
          "null"
        ],
        "description": "DKIM selectors found among those tested"
      },
      "mtaSts": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "MTA-STS record present"
      },
      "bimi": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "BIMI record present"
      },
      "caa": {
        "type": [
          "array",
          "null"
        ],
        "description": "CAA records"
      },
      "parkedOrForSale": {
        "type": [
          "string",
          "null"
        ],
        "description": "Parking/marketplace detected from nameservers"
      },
      "emailScore": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Email-authentication score 0-100 (see the README, How to read the score). 0 for domains that do not exist"
      },
      "issues": {
        "type": [
          "array",
          "null"
        ],
        "description": "Plain-English problems found, for example 'No DMARC record' or 'No MX records'. Empty list = nothing to report"
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "Error detail"
      },
      "checkedAt": {
        "type": [
          "string",
          "null"
        ],
        "description": "UTC timestamp"
      }
    },
    "required": [
      "domain",
      "issues",
      "checkedAt"
    ]
  },
  "views": {
    "overview": {
      "title": "Pre-send audit",
      "transformation": {
        "fields": [
          "domain",
